{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "paths": {
      "@workspace/shared": ["../packages/shared/src/index.ts"],
      "@workspace/shared/*": ["../packages/shared/src/*"]
    }
  },
  "include": ["src", "drizzle.config.ts"]
}
